# Copy to .env.local. Without the Supabase values, development uses a local JSON file
# (.data/bouquets.json) and runs without accounts.
#
# For local development with accounts, run `supabase start` and copy the values it
# prints (or `supabase status`): API URL, anon (publishable) key, service role (secret) key.

# Supabase project URL (Project Settings → API), e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The project's public key (anon / publishable). Safe in the browser: the database
# refuses it (row-level security), it only lets people sign in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (secret) key: SERVER ONLY. Never prefix it with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the URL the server uses to reach Supabase, if it differs from the public one.
SUPABASE_URL=

# Public site URL used for share links and link previews, e.g. https://bouquetcipher.app
# (on Vercel this falls back to the production domain automatically)
NEXT_PUBLIC_SITE_URL=

# Any random string; salts the hashed IPs used for rate limiting.
RATE_LIMIT_SALT=
